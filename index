<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ค้นหาสินค้าบุญถาวร</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f6f5f2;
    --surface: #ffffff;
    --surface-2: #f1efea;
    --text: #1d1d1b;
    --muted: #6b6a65;
    --border: #e3e0d9;
    --accent: #0f6e5c;
    --accent-hover: #0b5a4b;
    --accent-ink: #ffffff;
    --accent-soft: #e2f1ec;
    --price: #c2410c;
    --ok: #1f7a3a;
    --ok-soft: #e3f3e7;
    --bad: #b4321f;
    --bad-soft: #fbe8e4;
    --info: #1d5fa8;
    --info-soft: #e5eefa;
    --radius: 14px;
    --shadow: 0 1px 2px rgba(0, 0, 0, .04), 0 6px 20px rgba(0, 0, 0, .05);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141413;
      --surface: #1e1e1c;
      --surface-2: #282826;
      --text: #ecebe6;
      --muted: #a3a19a;
      --border: #363531;
      --accent: #4fbfa5;
      --accent-hover: #6fd0b9;
      --accent-ink: #0b1f1a;
      --accent-soft: #17322c;
      --price: #fb923c;
      --ok: #74d18f;
      --ok-soft: #173022;
      --bad: #f29482;
      --bad-soft: #3a1d18;
      --info: #8ab8f0;
      --info-soft: #172a42;
      --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 6px 20px rgba(0, 0, 0, .25);
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "IBM Plex Sans Thai", "Leelawadee UI", "Noto Sans Thai", Tahoma, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }

  header.site { padding: 40px 0 8px; }
  .eyebrow { margin: 0 0 6px; font-size: .8rem; font-weight: 600; letter-spacing: .04em; color: var(--accent); }
  h1 { margin: 0; font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.25; font-weight: 700; }
  .lede { margin: 8px 0 0; color: var(--muted); max-width: 60ch; }

  /* Search */
  .search { margin: 24px 0 8px; }
  .search label { display: block; font-weight: 600; margin-bottom: 8px; }
  .search-row { display: flex; gap: 10px; align-items: stretch; }
  .search textarea {
    flex: 1;
    min-height: 52px;
    max-height: 200px;
    resize: none;
    padding: 13px 16px;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .search textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 0 22px; min-height: 52px;
    font: inherit; font-weight: 600;
    color: var(--accent-ink); background: var(--accent);
    border: 0; border-radius: 12px; cursor: pointer;
    transition: background .15s;
    white-space: nowrap;
  }
  .btn:hover { background: var(--accent-hover); }
  .btn:disabled { opacity: .6; cursor: progress; }
  .btn:focus-visible, .btn-ghost:focus-visible, .chip:focus-visible, .thumb:focus-visible, summary:focus-visible, a:focus-visible {
    outline: 3px solid var(--accent); outline-offset: 2px;
  }
  .hint { margin: 10px 0 0; font-size: .875rem; color: var(--muted); }
  .examples { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; font-size: .875rem; color: var(--muted); }
  .chip {
    font: inherit; font-size: .85rem;
    padding: 2px 10px; border-radius: 999px;
    color: var(--accent); background: var(--accent-soft);
    border: 0; cursor: pointer;
  }
  .chip:hover { text-decoration: underline; }

  /* Status & toolbar */
  .status { margin: 20px 0 0; min-height: 1px; }
  .status .error {
    padding: 14px 16px; border-radius: 12px;
    background: var(--bad-soft); color: var(--bad);
  }
  .toolbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
    margin: 20px 0 12px;
  }
  .toolbar[hidden] { display: none; }
  .summary { margin: 0; color: var(--muted); }
  .summary strong { color: var(--text); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px;
    font: inherit; font-size: .9rem; font-weight: 500;
    color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px; cursor: pointer;
    text-decoration: none;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* Cards */
  .results { display: grid; gap: 16px; padding-bottom: 32px; }
  .card {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .media { min-width: 0; }
  .main-img {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .main-img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .no-img { color: #8a8880; font-size: .85rem; }
  .thumbs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .thumb {
    width: 44px; height: 44px; padding: 0;
    background: #fff; border: 1.5px solid var(--border); border-radius: 8px;
    overflow: hidden; cursor: pointer;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .thumb[aria-pressed="true"] { border-color: var(--accent); }

  .info { min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .meta-top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .85rem; }
  .tag { padding: 2px 10px; border-radius: 6px; background: var(--surface-2); color: var(--muted); }
  .tag strong { color: var(--text); font-weight: 600; }
  .brand { font-weight: 700; letter-spacing: .02em; color: var(--accent); }
  .name { margin: 0; font-size: 1.25rem; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
  .crumbs { margin: 0; font-size: .85rem; color: var(--muted); }

  .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .price { font-size: 1.75rem; font-weight: 700; color: var(--price); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .price small { font-size: .9rem; font-weight: 500; color: var(--muted); margin-left: 4px; }
  .was { color: var(--muted); text-decoration: line-through; font-variant-numeric: tabular-nums; }
  .off { padding: 1px 8px; border-radius: 6px; font-size: .8rem; font-weight: 700; color: #fff; background: var(--price); }
  @media (prefers-color-scheme: dark) { .off { color: #1e1e1c; } }

  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .pill { padding: 3px 10px; border-radius: 999px; font-size: .8rem; font-weight: 600; background: var(--surface-2); color: var(--muted); }
  .pill--ok { background: var(--ok-soft); color: var(--ok); }
  .pill--bad { background: var(--bad-soft); color: var(--bad); }
  .pill--info { background: var(--info-soft); color: var(--info); }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }

  details.more { grid-column: 1 / -1; border-top: 1px solid var(--border); padding-top: 14px; }
  details.more > summary {
    cursor: pointer; list-style: none;
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 600; color: var(--accent);
  }
  details.more > summary::-webkit-details-marker { display: none; }
  details.more > summary::before {
    content: ""; width: 7px; height: 7px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(-45deg); transition: transform .15s;
  }
  details.more[open] > summary::before { transform: rotate(45deg); }
  .more-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; margin-top: 14px; }
  .more-grid h3 { margin: 0 0 8px; font-size: .95rem; }
  .specs { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .specs th, .specs td { text-align: left; vertical-align: top; padding: 7px 0; border-bottom: 1px solid var(--border); }
  .specs th { width: 38%; padding-right: 12px; font-weight: 500; color: var(--muted); }
  .specs td { overflow-wrap: anywhere; }
  .desc { font-size: .92rem; overflow-wrap: anywhere; }
  .desc h1, .desc h2, .desc h3, .desc h4, .desc h5, .desc h6 { font-size: 1rem; margin: .4em 0; }
  .desc p { margin: .35em 0; }
  .desc ul, .desc ol { margin: .35em 0; padding-left: 1.3em; }
  .desc img { max-width: 100%; height: auto; }
  .desc table { border-collapse: collapse; max-width: 100%; }
  .desc td, .desc th { border: 1px solid var(--border); padding: 4px 8px; }
  .desc a { color: var(--accent); }
  .empty-note { color: var(--muted); font-size: .9rem; margin: 0; }

  .card--missing { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 16px; }
  .missing-icon {
    width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--bad-soft); color: var(--bad); font-weight: 700; font-size: 1.2rem;
  }
  .missing-title { margin: 0; font-weight: 600; }
  .muted { margin: 2px 0 0; color: var(--muted); font-size: .9rem; }
  code { font-family: ui-monospace, Consolas, monospace; font-size: .9em; padding: 1px 6px; border-radius: 5px; background: var(--surface-2); }

  /* Loading skeleton */
  .skeleton .sk { background: var(--surface-2); border-radius: 8px; position: relative; overflow: hidden; }
  .skeleton .sk::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .35), transparent);
    transform: translateX(-100%); animation: shimmer 1.2s infinite;
  }
  @media (prefers-color-scheme: dark) { .skeleton .sk::after { background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .06), transparent); } }
  @keyframes shimmer { to { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) { .skeleton .sk::after { animation: none; } }

  footer.site { padding: 8px 0 40px; font-size: .8rem; color: var(--muted); }

  @media (max-width: 680px) {
    header.site { padding-top: 28px; }
    .card { grid-template-columns: 1fr; gap: 16px; padding: 16px; }
    .media { width: 100%; max-width: 320px; margin: 0 auto; }
    .more-grid { grid-template-columns: 1fr; }
    .search-row { flex-direction: column; }
    .btn { width: 100%; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="site">
    <p class="eyebrow">ดึงข้อมูลจาก boonthavorn.com</p>
    <h1>ค้นหาข้อมูลสินค้าบุญถาวร</h1>
    <p class="lede">ใส่รหัสสินค้าเพื่อดูชื่อ ราคา สถานะสต็อก รูปภาพ และข้อมูลจำเพาะล่าสุดจากเว็บไซต์</p>
  </header>

  <main>
    <form class="search" id="search-form" autocomplete="off">
      <label for="codes">รหัสสินค้า</label>
      <div class="search-row">
        <textarea id="codes" rows="1" spellcheck="false" placeholder="เช่น 1015431"></textarea>
        <button class="btn" id="submit" type="submit">ค้นหา</button>
      </div>
      <p class="hint">ใส่ได้หลายรหัสพร้อมกัน คั่นด้วยเว้นวรรค จุลภาค หรือขึ้นบรรทัดใหม่ (Shift+Enter) · วางลิงก์หน้าสินค้าก็ได้</p>
      <div class="examples">
        <span>ลองตัวอย่าง:</span>
        <button class="chip" type="button" data-example="1015431">1015431</button>
        <button class="chip" type="button" data-example="1015431, 1068468, 1252051">หลายรหัส</button>
      </div>
    </form>

    <div class="status" id="status" role="status" aria-live="polite"></div>

    <div class="toolbar" id="toolbar" hidden>
      <p class="summary" id="summary"></p>
      <button class="btn-ghost" id="export" type="button">ดาวน์โหลด CSV</button>
    </div>

    <div class="results" id="results"></div>
  </main>

  <footer class="site">
    ข้อมูลดึงสดจาก boonthavorn.com ทุกครั้งที่ค้นหา ราคาและจำนวนสินค้าอาจเปลี่ยนแปลงได้ โปรดตรวจสอบกับหน้าเว็บไซต์ก่อนสั่งซื้อ
  </footer>
</div>

<script>
(() => {
  'use strict';

  const API = 'https://www.boonthavorn.com/graphql';
  const SITE = 'https://www.boonthavorn.com/';
  const STORE = 'th';
  const CHUNK = 20;
  const MAX_CODES = 200;
  // Attributes already shown elsewhere on the card, or boilerplate on every product.
  const HIDDEN_ATTRS = new Set(['sku', 'brand', 'remark']);

  const FIELDS = `items {
    sku name url_key url_suffix stock_status qty_in_stock ready_to_ship
    brand_items { title }
    categories { name url_path }
    attributes { label value code }
    media_gallery { url label position disabled }
    small_image { url }
    description { html }
    price_range { minimum_price {
      final_price { value currency }
      regular_price { value }
      discount { percent_off amount_off }
    } }
  }`;
  const buildQuery = (field) =>
    `query ($v: [String]) { products(filter: { ${field}: { in: $v } }, pageSize: ${CHUNK}) { ${FIELDS} } }`.replace(/\s+/g, ' ');
  const QUERY_BY_SKU = buildQuery('sku');
  const QUERY_BY_KEY = buildQuery('url_key');

  const $ = (sel) => document.querySelector(sel);
  const form = $('#search-form');
  const input = $('#codes');
  const submitBtn = $('#submit');
  const statusEl = $('#status');
  const toolbar = $('#toolbar');
  const summaryEl = $('#summary');
  const resultsEl = $('#results');
  const exportBtn = $('#export');

  let lastResults = [];
  let requestId = 0;

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const numFmt = new Intl.NumberFormat('th-TH', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  const money = (v) => (v == null ? '-' : numFmt.format(v));

  // ---------- Input parsing ----------
  function parseInput(text) {
    const seen = new Set();
    const out = [];
    for (const raw of text.split(/[\s,;]+/)) {
      const t = raw.trim();
      if (!t) continue;
      let entry = null;
      if (/^https?:\/\//i.test(t) || /boonthavorn\.com/i.test(t)) {
        try {
          const u = new URL(/^https?:/i.test(t) ? t : 'https://' + t);
          const seg = u.pathname.split('/').filter(Boolean).pop() || '';
          const key = decodeURIComponent(seg).replace(/\.html?$/i, '');
          if (key) entry = { input: t, kind: 'key', value: key };
        } catch (_) { /* not a usable URL */ }
      } else {
        entry = { input: t, kind: 'sku', value: t };
      }
      if (!entry) continue;
      const id = entry.kind + ':' + entry.value.toLowerCase();
      if (seen.has(id)) continue;
      seen.add(id);
      out.push(entry);
    }
    return out;
  }

  // ---------- Data fetching ----------
  async function gql(query, values) {
    // GET + ?store= keeps this a "simple" CORS request (no preflight); the API answers with Access-Control-Allow-Origin: *.
    const params = new URLSearchParams({ query, variables: JSON.stringify({ v: values }), store: STORE });
    const res = await fetch(`${API}?${params}`, { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error(`เซิร์ฟเวอร์ตอบกลับ HTTP ${res.status}`);
    const json = await res.json();
    const items = json && json.data && json.data.products && json.data.products.items;
    if (!items) throw new Error((json && json.errors && json.errors[0] && json.errors[0].message) || 'รูปแบบข้อมูลที่ได้รับไม่ถูกต้อง');
    return items;
  }

  async function fetchAll(query, values) {
    if (!values.length) return [];
    const chunks = [];
    for (let i = 0; i < values.length; i += CHUNK) chunks.push(values.slice(i, i + CHUNK));
    return (await Promise.all(chunks.map((c) => gql(query, c)))).flat();
  }

  async function lookup(entries) {
    const bySku = new Map();
    const byKey = new Map();
    const index = (items) => items.forEach((p) => {
      if (p.sku) bySku.set(p.sku.toLowerCase(), p);
      if (p.url_key) byKey.set(p.url_key.toLowerCase(), p);
    });
    const find = (e) => (e.kind === 'sku' ? bySku.get(e.value.toLowerCase()) || byKey.get(e.value.toLowerCase()) : byKey.get(e.value.toLowerCase()));

    const [a, b] = await Promise.all([
      fetchAll(QUERY_BY_SKU, entries.filter((e) => e.kind === 'sku').map((e) => e.value)),
      fetchAll(QUERY_BY_KEY, entries.filter((e) => e.kind === 'key').map((e) => e.value)),
    ]);
    index(a);
    index(b);

    // A bare URL key like "bosch-1015431" won't match as a SKU; retry those as URL keys.
    const retry = entries.filter((e) => e.kind === 'sku' && !find(e) && /^[a-z0-9]+(-[a-z0-9]+)+$/i.test(e.value));
    if (retry.length) index(await fetchAll(QUERY_BY_KEY, retry.map((e) => e.value)));

    return entries.map((e) => {
      const p = find(e);
      return { entry: e, view: p ? normalize(p) : null };
    });
  }

  function normalize(p) {
    const attrs = (p.attributes || []).filter((x) => x && x.value != null && String(x.value).trim() !== '');
    const attr = (code) => (attrs.find((x) => x.code === code) || {}).value;
    const mp = (p.price_range && p.price_range.minimum_price) || {};
    const final = mp.final_price ? mp.final_price.value : null;
    const regular = mp.regular_price ? mp.regular_price.value : null;
    const pct = (mp.discount && mp.discount.percent_off) || 0;

    const images = (p.media_gallery || [])
      .filter((m) => m && m.url && !m.disabled)
      .sort((x, y) => (x.position || 0) - (y.position || 0))
      .map((m) => m.url);
    if (!images.length && p.small_image && p.small_image.url) images.push(p.small_image.url);

    const cats = (p.categories || []).filter((c) => c && c.url_path);
    const deepest = cats.reduce((d, c) => (!d || c.url_path.length > d.url_path.length ? c : d), null);
    const crumbs = deepest
      ? cats.filter((c) => deepest.url_path === c.url_path || deepest.url_path.startsWith(c.url_path + '/'))
          .sort((x, y) => x.url_path.length - y.url_path.length)
          .map((c) => c.name)
      : [];

    const brandItem = Array.isArray(p.brand_items) ? p.brand_items[0] : p.brand_items;
    return {
      sku: p.sku,
      name: p.name,
      brand: (brandItem && brandItem.title) || attr('brand') || '',
      url: SITE + (p.url_key || '') + (p.url_suffix || ''),
      final,
      regular,
      pct,
      unit: attr('unit') || '',
      inStock: p.stock_status === 'IN_STOCK',
      qty: p.qty_in_stock,
      readyToShip: Number(p.ready_to_ship) === 1,
      images,
      crumbs,
      specs: attrs.filter((x) => !HIDDEN_ATTRS.has(x.code)),
      description: p.description ? p.description.html : '',
    };
  }

  // ---------- HTML sanitizing (product descriptions come from the remote site) ----------
  const DROP_TAGS = new Set(['SCRIPT', 'STYLE', 'OBJECT', 'EMBED', 'FORM', 'INPUT', 'BUTTON', 'SELECT', 'TEXTAREA', 'LINK', 'META', 'SVG', 'MATH', 'TEMPLATE', 'NOSCRIPT']);
  const KEEP_TAGS = new Set(['P', 'BR', 'B', 'STRONG', 'I', 'EM', 'U', 'UL', 'OL', 'LI', 'TABLE', 'THEAD', 'TBODY', 'TR', 'TD', 'TH', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'A', 'IMG', 'SUB', 'SUP', 'HR']);

  function videoLink(src) {
    const m = /youtube(?:-nocookie)?\.com\/embed\/([\w-]{6,})/i.exec(src || '');
    return m ? 'https://www.youtube.com/watch?v=' + m[1] : null;
  }

  function cleanNode(node) {
    const doc = node.ownerDocument;
    for (const child of Array.from(node.childNodes)) {
      if (child.nodeType === Node.TEXT_NODE) continue;
      if (child.nodeType !== Node.ELEMENT_NODE) { child.remove(); continue; }
      const tag = child.tagName;
      if (DROP_TAGS.has(tag)) { child.remove(); continue; }
      if (tag === 'IFRAME') {
        const href = videoLink(child.getAttribute('src'));
        if (href) {
          const a = doc.createElement('a');
          a.href = href;
          a.textContent = '▶ ดูวิดีโอบน YouTube';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          child.replaceWith(a);
        } else {
          child.remove();
        }
        continue;
      }
      cleanNode(child);
      if (!KEEP_TAGS.has(tag)) { child.replaceWith(...Array.from(child.childNodes)); continue; }
      for (const at of Array.from(child.attributes)) {
        const n = at.name.toLowerCase();
        const keep =
          (tag === 'A' && n === 'href' && /^https?:/i.test(at.value)) ||
          (tag === 'IMG' && n === 'src' && /^https:/i.test(at.value)) ||
          (tag === 'IMG' && n === 'alt') ||
          ((tag === 'TD' || tag === 'TH') && (n === 'colspan' || n === 'rowspan'));
        if (!keep) child.removeAttribute(at.name);
      }
      if (tag === 'A') { child.target = '_blank'; child.rel = 'noopener noreferrer'; }
      if (tag === 'IMG') {
        if (!child.getAttribute('src')) { child.remove(); continue; }
        child.loading = 'lazy';
        child.referrerPolicy = 'no-referrer';
      }
      // Drop spacer paragraphs (the site uses lots of <p>&nbsp;</p>).
      if (tag === 'P' && !child.textContent.replace(/[\s ]+/g, '') && !child.querySelector('img,a')) child.remove();
    }
  }

  function sanitize(html) {
    if (!html) return '';
    const doc = new DOMParser().parseFromString('<div>' + html + '</div>', 'text/html');
    const root = doc.body.firstElementChild;
    if (!root) return '';
    cleanNode(root);
    return root.innerHTML.trim();
  }

  // ---------- Rendering ----------
  function renderMissing(r) {
    return `<article class="card card--missing">
      <div class="missing-icon" aria-hidden="true">?</div>
      <div>
        <p class="missing-title">ไม่พบสินค้า</p>
        <p class="muted">ไม่พบข้อมูลสำหรับ <code>${esc(r.entry.input)}</code> ลองตรวจสอบรหัสสินค้าอีกครั้ง</p>
      </div>
    </article>`;
  }

  function renderCard(r, open) {
    if (!r.view) return renderMissing(r);
    const v = r.view;
    const mainImg = v.images[0];
    const media = `<div class="media">
      <a class="main-img" href="${esc(v.url)}" target="_blank" rel="noopener noreferrer" aria-label="เปิดหน้าสินค้า">
        ${mainImg ? `<img src="${esc(mainImg)}" alt="${esc(v.name)}" loading="lazy" referrerpolicy="no-referrer">` : '<span class="no-img">ไม่มีรูปภาพ</span>'}
      </a>
      ${v.images.length > 1 ? `<div class="thumbs">${v.images.slice(0, 8).map((src, i) =>
        `<button class="thumb" type="button" data-src="${esc(src)}" aria-pressed="${i === 0}" aria-label="รูปที่ ${i + 1}"><img src="${esc(src)}" alt="" loading="lazy" referrerpolicy="no-referrer"></button>`).join('')}</div>` : ''}
    </div>`;

    const hasDiscount = v.pct > 0 && v.regular != null && v.final != null && v.regular > v.final;
    const price = v.final == null
      ? '<span class="price" style="font-size:1.1rem">ไม่ระบุราคา</span>'
      : `<span class="price">${money(v.final)}<small>บาท${v.unit ? ' / ' + esc(v.unit) : ''}</small></span>
         ${hasDiscount ? `<span class="was">${money(v.regular)} บาท</span><span class="off">-${Math.round(v.pct)}%</span>` : ''}`;

    const pills = [
      v.inStock ? '<span class="pill pill--ok">มีสินค้า</span>' : '<span class="pill pill--bad">สินค้าหมด</span>',
      v.inStock && v.qty != null ? `<span class="pill">คงเหลือ ${numFmt.format(v.qty)} ${esc(v.unit || 'ชิ้น')}</span>` : '',
      v.readyToShip ? '<span class="pill pill--info">พร้อมส่ง</span>' : '',
    ].join('');

    const specs = v.specs.length
      ? `<table class="specs"><tbody>${v.specs.map((s) =>
          `<tr><th scope="row">${esc(s.label)}</th><td>${sanitize(String(s.value))}</td></tr>`).join('')}</tbody></table>`
      : '<p class="empty-note">ไม่มีข้อมูลจำเพาะ</p>';
    const desc = sanitize(v.description);

    return `<article class="card">
      ${media}
      <div class="info">
        <div class="meta-top">
          <span class="tag">รหัส <strong>${esc(v.sku)}</strong></span>
          ${v.brand ? `<span class="brand">${esc(v.brand)}</span>` : ''}
        </div>
        <h2 class="name">${esc(v.name)}</h2>
        ${v.crumbs.length ? `<p class="crumbs">${v.crumbs.map(esc).join(' › ')}</p>` : ''}
        <div class="price-row">${price}</div>
        <div class="pills">${pills}</div>
        <div class="actions">
          <a class="btn-ghost" href="${esc(v.url)}" target="_blank" rel="noopener noreferrer">ดูบนเว็บไซต์บุญถาวร ↗</a>
        </div>
      </div>
      <details class="more"${open ? ' open' : ''}>
        <summary>ข้อมูลจำเพาะและรายละเอียดสินค้า</summary>
        <div class="more-grid">
          <section><h3>ข้อมูลจำเพาะ</h3>${specs}</section>
          <section><h3>รายละเอียดสินค้า</h3>${desc ? `<div class="desc">${desc}</div>` : '<p class="empty-note">ไม่มีรายละเอียด</p>'}</section>
        </div>
      </details>
    </article>`;
  }

  function renderSkeleton(n) {
    const one = `<article class="card skeleton" aria-hidden="true">
      <div class="media"><div class="sk" style="aspect-ratio:1/1"></div></div>
      <div class="info">
        <div class="sk" style="height:18px;width:120px"></div>
        <div class="sk" style="height:26px;width:85%"></div>
        <div class="sk" style="height:16px;width:55%"></div>
        <div class="sk" style="height:34px;width:160px"></div>
        <div class="sk" style="height:22px;width:200px"></div>
      </div>
    </article>`;
    resultsEl.innerHTML = one.repeat(Math.max(1, Math.min(n, 3)));
  }

  function showError(msg) {
    statusEl.innerHTML = `<div class="error">${esc(msg)}</div>`;
  }

  // ---------- Search flow ----------
  async function run(text) {
    const entries = parseInput(text);
    if (!entries.length) {
      showError('กรุณาใส่รหัสสินค้าอย่างน้อย 1 รหัส');
      input.focus();
      return;
    }
    if (entries.length > MAX_CODES) {
      showError(`ค้นหาได้ครั้งละไม่เกิน ${MAX_CODES} รหัส (ใส่มา ${entries.length} รหัส)`);
      return;
    }

    const id = ++requestId;
    statusEl.innerHTML = '';
    toolbar.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'กำลังค้นหา…';
    renderSkeleton(entries.length);
    try {
      history.replaceState(null, '', '#' + encodeURIComponent(entries.map((e) => e.input).join(',')));
    } catch (_) { /* file:// in some browsers */ }

    try {
      const results = await lookup(entries);
      if (id !== requestId) return;
      lastResults = results;
      const found = results.filter((r) => r.view).length;
      resultsEl.innerHTML = results.map((r) => renderCard(r, results.length === 1)).join('');
      summaryEl.innerHTML = `พบ <strong>${found}</strong> จาก ${results.length} รายการ`;
      toolbar.hidden = false;
      exportBtn.hidden = found === 0;
    } catch (err) {
      if (id !== requestId) return;
      resultsEl.innerHTML = '';
      const offline = err instanceof TypeError;
      showError(offline
        ? 'เชื่อมต่อ boonthavorn.com ไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต หรือเว็บไซต์อาจจำกัดการเรียกข้อมูลชั่วคราว ลองใหม่อีกครั้งในอีกสักครู่'
        : 'ดึงข้อมูลไม่สำเร็จ: ' + err.message);
    } finally {
      if (id === requestId) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'ค้นหา';
      }
    }
  }

  // ---------- CSV export ----------
  function toCSV(results) {
    const head = ['รหัสที่ค้นหา', 'รหัสสินค้า', 'ชื่อสินค้า', 'ยี่ห้อ', 'ราคาขาย (บาท)', 'ราคาปกติ (บาท)', 'ส่วนลด (%)', 'หน่วยนับ', 'สถานะ', 'คงเหลือ', 'พร้อมส่ง', 'หมวดหมู่', 'ลิงก์'];
    const rows = results.map((r) => {
      const v = r.view;
      if (!v) return [r.entry.input, '', 'ไม่พบสินค้า', '', '', '', '', '', '', '', '', '', ''];
      return [r.entry.input, v.sku, v.name, v.brand, v.final ?? '', v.regular ?? '', v.pct ? v.pct.toFixed(2) : '0',
        v.unit, v.inStock ? 'มีสินค้า' : 'สินค้าหมด', v.qty ?? '', v.readyToShip ? 'ใช่' : '', v.crumbs.join(' > '), v.url];
    });
    const cell = (x) => {
      const s = String(x ?? '');
      return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    return '﻿' + [head, ...rows].map((row) => row.map(cell).join(',')).join('\r\n');
  }

  function download() {
    if (!lastResults.length) return;
    const blob = new Blob([toCSV(lastResults)], { type: 'text/csv;charset=utf-8' });
    const d = new Date();
    const pad = (n) => String(n).padStart(2, '0');
    const name = `boonthavorn-${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}.csv`;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  // ---------- Events ----------
  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight + 3, 200) + 'px';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      form.requestSubmit();
    }
  });
  input.addEventListener('input', autoGrow);
  form.addEventListener('click', (e) => {
    const chip = e.target.closest('[data-example]');
    if (!chip) return;
    input.value = chip.dataset.example;
    autoGrow();
    run(input.value);
  });
  resultsEl.addEventListener('click', (e) => {
    const thumb = e.target.closest('.thumb');
    if (!thumb) return;
    const card = thumb.closest('.card');
    const main = card.querySelector('.main-img img');
    if (main) main.src = thumb.dataset.src;
    card.querySelectorAll('.thumb').forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
  });
  exportBtn.addEventListener('click', download);

  // Restore a search from the URL hash, e.g. index.html#1015431,1068468
  function runFromHash() {
    let codes = '';
    try { codes = decodeURIComponent(location.hash.slice(1)); } catch (_) { codes = location.hash.slice(1); }
    if (!codes) return false;
    input.value = codes.split(',').join(', ');
    autoGrow();
    run(codes);
    return true;
  }
  window.addEventListener('hashchange', runFromHash);
  if (!runFromHash()) input.focus();
})();
</script>
</body>
